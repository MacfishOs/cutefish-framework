@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 COMPONENTS Core Gui DBus Qml)

# Without COMPONENTS only Application, Appearance and IO are imported.
set(_cutefish_framework_components ${CutefishFramework_FIND_COMPONENTS})
if(NOT _cutefish_framework_components)
    set(_cutefish_framework_components Application Appearance IO)
endif()

foreach(_component IN LISTS _cutefish_framework_components)
    if(_component STREQUAL "IO")
        # IO keeps its own package so it can still be built and used standalone.
        find_dependency(CutefishIO)
        set(CutefishFramework_IO_FOUND ${CutefishIO_FOUND})
    else()
        if(_component STREQUAL "Protocols" AND NOT TARGET PkgConfig::WaylandClient)
            # The bindings' headers include wayland-client.h.
            find_dependency(PkgConfig)
            pkg_check_modules(WaylandClient REQUIRED IMPORTED_TARGET wayland-client)
        elseif(_component STREQUAL "ScrollingQuick")
            find_dependency(Qt6 COMPONENTS Quick)
        elseif(_component STREQUAL "ScrollingWidgets")
            find_dependency(Qt6 COMPONENTS Widgets)
        endif()
        # Both scrolling adapters link the shared physics.
        if(_component MATCHES "^Scrolling.+" AND NOT TARGET Cutefish::Scrolling)
            include("${CMAKE_CURRENT_LIST_DIR}/CutefishFrameworkScrollingTargets.cmake")
        endif()
        if(_component STREQUAL "Application")
            include("${CMAKE_CURRENT_LIST_DIR}/CutefishApplication.cmake")
        endif()
        set(_targets "${CMAKE_CURRENT_LIST_DIR}/CutefishFramework${_component}Targets.cmake")
        if(EXISTS "${_targets}")
            include("${_targets}")
            set(CutefishFramework_${_component}_FOUND TRUE)
        else()
            set(CutefishFramework_${_component}_FOUND FALSE)
        endif()
        unset(_targets)
    endif()
endforeach()

unset(_cutefish_framework_components)
check_required_components(CutefishFramework)
