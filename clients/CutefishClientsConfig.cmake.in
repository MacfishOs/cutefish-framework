@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CutefishToolkit)

foreach(_component IN LISTS CutefishClients_FIND_COMPONENTS)
    set(_targets "${CMAKE_CURRENT_LIST_DIR}/CutefishClient${_component}Targets.cmake")
    if(EXISTS "${_targets}")
        include("${_targets}")
        set(CutefishClients_${_component}_FOUND TRUE)
    else()
        set(CutefishClients_${_component}_FOUND FALSE)
    endif()
    unset(_targets)
endforeach()

check_required_components(CutefishClients)
